<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ana Arka Plan -->
    <Color x:Key="Color.Background">#111111</Color>

    <!-- İkinci Arka Plan -->
    <Color x:Key="Color.Surface">#1A1A1A</Color>

    <!-- Kart -->
    <Color x:Key="Color.Card">#242424</Color>

    <!-- Kart Hover -->
    <Color x:Key="Color.CardHover">#2E2E2E</Color>

    <!-- Ana Altın -->
    <Color x:Key="Color.Gold">#C89A4B</Color>

    <!-- Açık Altın -->
    <Color x:Key="Color.GoldLight">#E2C27B</Color>

    <!-- Koyu Altın -->
    <Color x:Key="Color.GoldDark">#8F6A2D</Color>

    <!-- Beyaz -->
    <Color x:Key="Color.White">#FFFFFF</Color>

    <!-- Açık Gri -->
    <Color x:Key="Color.LightText">#D7D7D7</Color>

    <!-- Koyu Gri -->
    <Color x:Key="Color.Gray">#8C8C8C</Color>

    <!-- Başarı -->
    <Color x:Key="Color.Success">#2ECC71</Color>

    <!-- Uyarı -->
    <Color x:Key="Color.Warning">#F39C12</Color>

    <!-- Hata -->
    <Color x:Key="Color.Danger">#E74C3C</Color>

</ResourceDictionary>