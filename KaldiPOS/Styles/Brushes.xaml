<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Background"
                     Color="#11100E" />

    <SolidColorBrush x:Key="Brush.Surface"
                     Color="#1A1815" />

    <SolidColorBrush x:Key="Brush.Card"
                     Color="#24211D" />

    <SolidColorBrush x:Key="Brush.CardHover"
                     Color="#302B25" />

    <SolidColorBrush x:Key="Brush.Gold"
                     Color="#C89B52" />

    <SolidColorBrush x:Key="Brush.GoldLight"
                     Color="#E2BE79" />

    <SolidColorBrush x:Key="Brush.GoldDark"
                     Color="#765A32" />

    <SolidColorBrush x:Key="Brush.White"
                     Color="#FFFDF8" />

    <SolidColorBrush x:Key="Brush.LightText"
                     Color="#DED8CD" />

    <SolidColorBrush x:Key="Brush.Gray"
                     Color="#9D978D" />

    <SolidColorBrush x:Key="Brush.Success"
                     Color="#5FB67A" />

