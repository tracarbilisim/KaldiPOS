<Page x:Class="KaldiPOS.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="KaldiScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#A97831"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KaldiVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#201D19" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KaldiScrollBarThumb}"
                                           MinHeight="34" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KaldiHorizontalScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#201D19" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KaldiScrollBarThumb}"
                                           MinWidth="34" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="6" />
            <RowDefinition Height="34" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KATEGORİLER -->
        <Border Grid.Row="0"
                Padding="10,7"
                Background="#181613"
                BorderBrush="#765A32"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="KATEGORİLER"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#E2BE79" />

                    <TextBlock x:Name="CategoryCountText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="#9D978D" />
                </Grid>

                <WrapPanel x:Name="CategoryPanel"
                           Grid.Row="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- ARAMA VE YENİ ÜRÜN -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#181613"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⌕"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               Foreground="#E2BE79" />

                    <TextBox x:Name="ProductSearchTextBox"
                             Grid.Column="1"
                             Padding="0,0,10,0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             Foreground="#FFFDF8"
                             BorderThickness="0"
                             FontSize="13"
                             TextChanged="ProductSearchTextBox_TextChanged" />
                </Grid>
            </Border>

            <Button Grid.Column="2"
                    Content="+ Yeni Ürün"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#17130E"
                    Background="#D2A654"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="NewProductButton_Click" />
        </Grid>

        <!-- ÜRÜNLER -->
        <Border Grid.Row="4"
                Padding="10"
                Background="#181613"
                BorderBrush="#765A32"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ÜRÜNLER"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#E2BE79" />

                    <TextBlock x:Name="ProductCountText"
                               Margin="10,1,0,0"
                               FontSize="11"
                               Foreground="#9D978D" />
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">

                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource KaldiVerticalScrollBar}" />
                    </ScrollViewer.Resources>

                    <ItemsControl x:Name="ProductItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="170"
                                        Height="246"
                                        Margin="5"
                                        Background="#24211D"
                                        BorderBrush="#51432F"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="103" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="38" />
                                        </Grid.RowDefinitions>

                                        <Border Margin="7,7,7,0"
                                                Background="#11100E"
                                                CornerRadius="6"
                                                ClipToBounds="True">
                                            <Image Source="{Binding ImagePath}"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Row="1"
                                                    Margin="10,8,10,4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFDF8"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="36" />

                                            <TextBlock Text="{Binding Category}"
                                                       Margin="0,4,0,0"
                                                       FontSize="9.5"
                                                       Foreground="#9D978D"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding PriceText}"
                                                       Margin="0,6,0,0"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#E2BE79" />
                                        </StackPanel>

                                        <Grid Grid.Row="2"
                                              Background="#201D19">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <Button Content="✎"
                                                    Tag="{Binding}"
                                                    FontSize="15"
                                                    Foreground="#FFFDF8"
                                                    Background="Transparent"
                                                    BorderBrush="#51432F"
                                                    BorderThickness="0,1,1,0"
                                                    Cursor="Hand"
                                                    ToolTip="Düzenle"
                                                    Click="EditProductButton_Click" />

                                            <Button Grid.Column="1"
                                                    Content="▣"
                                                    Tag="{Binding}"
                                                    FontSize="14"
                                                    Foreground="#FFFDF8"
                                                    Background="Transparent"
                                                    BorderBrush="#51432F"
                                                    BorderThickness="0,1,1,0"
                                                    Cursor="Hand"
                                                    ToolTip="Resmi değiştir"
                                                    Click="ImageProductButton_Click" />

                                            <Button Grid.Column="2"
                                                    Content="×"
                                                    Tag="{Binding}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#E45B64"
                                                    Background="Transparent"
                                                    BorderBrush="#51432F"
                                                    BorderThickness="0,1,0,0"
                                                    Cursor="Hand"
                                                    ToolTip="Pasif yap"
                                                    Click="DisableProductButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
