<Page x:Class="KaldiPOS.Views.AuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#171512">

    <Page.Resources>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#211E1A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Page.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST BAŞLIK VE TARİH -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="İptal Edilen Adisyonlar"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Yalnızca yetkili yönetici hesaplarının erişebildiği gizli denetim kayıtları"
                           Margin="0,4,0,0"
                           Foreground="#AFA89D"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Border Width="175"
        Height="40"
        CornerRadius="8"
        BorderBrush="#765A32"
        BorderThickness="1"
        Background="#211E1A">

                    <DatePicker x:Name="AuditDatePicker"
                Margin="8,0"
                VerticalContentAlignment="Center"
                FontSize="15"
                Background="Transparent"
                BorderThickness="0"
                Foreground="White"
                SelectedDateChanged="AuditDatePicker_SelectedDateChanged"/>
                </Border>

                <Button Content="YENİLE"
                        Width="105"
                        Height="40"
                        Margin="10,0,0,0"
                        Click="RefreshButton_Click"
                        Background="#D4A64F"
                        Foreground="#171512"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- ÖZET KARTLARI -->
        <Grid Grid.Row="1"
              Margin="0,18,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">

                <StackPanel>
                    <TextBlock Text="İPTAL SAYISI"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="CancelledCountText"
                               Margin="0,7,0,0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">

                <StackPanel>
                    <TextBlock Text="İPTAL EDİLEN TUTAR"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="CancelledAmountText"
                               Margin="0,7,0,0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#E2B85F"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">

                <StackPanel>
                    <TextBlock Text="SEÇİLEN TARİH"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SelectedDateText"
                               Margin="0,7,0,0"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#69A6F3"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- İPTAL LİSTESİ -->
        <Border Grid.Row="2"
                CornerRadius="12"
                BorderBrush="#765A32"
                BorderThickness="1"
                Background="#1D1A17"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="2,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="GİZLİ DENETİM KAYITLARI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                    <TextBlock Grid.Column="1"
                               Text="Bu kayıtlar satış ve gün sonu raporlarında gösterilmez."
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#AFA89D"/>
                </Grid>

                <ListView x:Name="CancelledOrdersListView"
                          Grid.Row="1"
                          MouseDoubleClick="CancelledOrdersListView_MouseDoubleClick"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Margin"
                                    Value="0,0,0,7"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15"
                                    CornerRadius="8"
                                    Background="#29251F"
                                    BorderBrush="#554225"
                                    BorderThickness="1">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="145"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#D4A64F"/>

                                        <TextBlock Text="{Binding DateText}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="#AFA89D"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TableName}"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="İptal Eden"
                                                   FontSize="10"
                                                   Foreground="#91897D"/>

                                        <TextBlock Text="{Binding CancelledBy}"
                                                   Margin="0,3,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C9C2B7"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                Margin="12,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="İptal Sebebi"
                                                   FontSize="10"
                                                   Foreground="#91897D"/>

                                        <TextBlock Text="{Binding CancelReason}"
                                                   Margin="0,3,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="42"
                                                   ToolTip="{Binding CancelReason}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding AmountText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#E2B85F"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyPanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <TextBlock Text="✓"
                               HorizontalAlignment="Center"
                               FontSize="34"
                               Foreground="#56D47E"/>

                    <TextBlock Text="Seçilen tarihte iptal edilmiş adisyon bulunmuyor."
                               Margin="0,10,0,0"
                               FontSize="16"
                               Foreground="#8F887F"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>