<Window x:Class="KaldiPOS.Views.TableTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masa Aktar"
        Width="620"
        Height="500"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="TransferScrollBarThumbStyle"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#D2A654"
                                CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#171512"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb MinHeight="32"
                                           Style="{StaticResource TransferScrollBarThumbStyle}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransferWindowButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#11100E"
            BorderBrush="#765A32"
            BorderThickness="1"
            CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ÖZEL BAŞLIK ÇUBUĞU -->
            <Border Grid.Row="0"
                    Background="#181613"
                    BorderBrush="#765A32"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="▦"
                                   Margin="0,0,10,0"
                                   FontSize="18"
                                   Foreground="#E2BE79"/>

                        <TextBlock Text="Masa Aktar"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFDF8"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Content="✕"
                            FontSize="13"
                            Foreground="#FFFDF8"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Style="{StaticResource TransferWindowButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- İÇERİK -->
            <Grid Grid.Row="1"
                  Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Adisyonun aktarılacağı boş masayı seçin."
                           Margin="0,2,0,16"
                           FontSize="14"
                           Foreground="#B8B2A8"/>

                <Border Grid.Row="1"
                        Padding="12"
                        Background="#1B1916"
                        BorderBrush="#51432F"
                        BorderThickness="1"
                        CornerRadius="8">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <WrapPanel x:Name="TablesPanel"
                                   HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SelectedTableText"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E2BE79"
                               Text="Hedef masa seçilmedi"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button Width="110"
                                Height="42"
                                Margin="0,0,10,0"
                                Content="İptal"
                                Background="#24211D"
                                BorderBrush="#765A32"
                                Foreground="#FFFDF8"
                                Style="{StaticResource TransferWindowButtonStyle}"
                                Click="CancelButton_Click"/>

                        <Button Width="130"
                                Height="42"
                                Content="Aktar"
                                Background="#D2A654"
                                BorderBrush="#E2BE79"
                                Foreground="#17130E"
                                Style="{StaticResource TransferWindowButtonStyle}"
                                Click="TransferButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>