<Window x:Class="KaldiPOS.Views.UserPermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanıcı Yetki Yönetimi"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#0F100F">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#171715"/>
        <SolidColorBrush x:Key="Card" Color="#1D1C19"/>
        <SolidColorBrush x:Key="Gold" Color="#D9A943"/>
        <SolidColorBrush x:Key="Border" Color="#5B4524"/>
        <SolidColorBrush x:Key="Text" Color="#F5F1E8"/>
        <SolidColorBrush x:Key="Muted" Color="#B5AEA1"/>
        <SolidColorBrush x:Key="Danger" Color="#E25345"/>
        <SolidColorBrush x:Key="Success" Color="#50B85B"/>

        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#191816"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TemplateButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#191816"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BottomButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#191816"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PermissionCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="#0F100F"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAŞLIK -->
            <Border Grid.Row="0"
                    Background="#111210"
                    BorderBrush="#40331F"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">

                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Width="155"
                            Height="48"
                            Content="←  GERİ"
                            Click="CancelButton_Click"
                            Foreground="{StaticResource Gold}"
                            Background="#171715"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            FontSize="15"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <StackPanel Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Kullanıcı Yetki Yönetimi"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Bütün yetkileri tek ekranda görüntüleyin ve düzenleyin"
                                   Margin="0,5,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Vazgeç"
                                Style="{StaticResource TopButton}"
                                Click="CancelButton_Click"/>
                        <Button Content="Yetkileri Kaydet"
                                Style="{StaticResource TopButton}"
                                Click="SaveButton_Click"
                                Foreground="#17130D"
                                Background="{StaticResource Gold}"
                                BorderThickness="0"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ANA İÇERİK -->
            <Grid Grid.Row="1" Margin="12,8,12,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL KULLANICI / ŞABLON PANELİ -->
                <Border Grid.Column="0"
                        Padding="14"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid HorizontalAlignment="Center">
                            <Ellipse Width="70"
                                     Height="70"
                                     Fill="{StaticResource Gold}"/>
                            <TextBlock Text="●"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="53"
                                       Foreground="#17130D"/>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,6,0,8"
                                    HorizontalAlignment="Center">
                            <TextBlock x:Name="SelectedUserNameText"
                                       Text="Kullanıcı"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="SelectedUserRoleText"
                                       Text="Rol"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource Muted}"/>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Margin="0,0,0,9"
                                Padding="10,6"
                                Background="#191816"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Seçili Yetki Sayısı"
                                               FontSize="12"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SelectedPermissionCountText"
                                               Text="0"
                                               Margin="0,3,0,0"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Gold}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="✓"
                                           VerticalAlignment="Center"
                                           FontSize="25"
                                           Foreground="{StaticResource Success}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="0,0,0,12"
                                Padding="10,6"
                                Background="#191816"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <StackPanel>
                                <TextBlock Text="Kategori Sayısı"
                                           FontSize="12"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="CategoryCountText"
                                           Text="0"
                                           Margin="0,3,0,0"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Gold}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="HAZIR YETKİ ŞABLONLARI"
                                       Margin="0,0,0,8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Gold}"/>

                            <Button Content="Garson (Önerilen)"
                                    Style="{StaticResource TemplateButton}"
                                    Click="WaiterTemplateButton_Click"/>
                            <Button Content="Kasiyer"
                                    Style="{StaticResource TemplateButton}"
                                    Click="CashierTemplateButton_Click"/>
                            <Button Content="Müdür"
                                    Style="{StaticResource TemplateButton}"
                                    Click="ManagerTemplateButton_Click"/>
                            <Button Content="Yönetici (Tüm Yetkiler)"
                                    Style="{StaticResource TemplateButton}"
                                    Click="AdministratorTemplateButton_Click"/>
                            <Button Content="Özel Yetki (Sıfırdan)"
                                    Style="{StaticResource TemplateButton}"
                                    Click="CustomTemplateButton_Click"/>
                        </StackPanel>

                        <Button Grid.Row="5"
                                Content="Tüm Yetkileri Kaldır"
                                Height="42"
                                Click="ClearAllButton_Click"
                                Foreground="{StaticResource Danger}"
                                Background="#201615"
                                BorderBrush="#7B2E28"
                                BorderThickness="1"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- TEK EKRAN YETKİ TABLOSU -->
                <Border Grid.Column="2"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="64"/>
                        </Grid.RowDefinitions>

                        <ItemsControl x:Name="CategoryColumnsItemsControl"
                                      Margin="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#40331F"
                                            BorderThickness="0,0,1,0"
                                            Padding="10,0">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="58"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="44"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Background="#121310"
                                                    BorderBrush="{StaticResource Gold}"
                                                    BorderThickness="0,0,0,2">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryName}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Gold}"
                                                               TextAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedCountText}"
                                                               Margin="0,1,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Success}"
                                                               TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <ItemsControl Grid.Row="1"
                                                          Margin="0,10,0,10"
                                                          ItemsSource="{Binding Permissions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,7"
                                                                Padding="10,10"
                                                                MinHeight="56"
                                                                Background="{StaticResource Card}"
                                                                BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">

                                                            <CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Click="PermissionCheckBox_Click"
                                                                      Style="{StaticResource PermissionCheckBox}">
                                                                <StackPanel Margin="5,0,0,0">
                                                                    <TextBlock Text="{Binding PermissionName}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource Text}"/>

                                                                    
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid Grid.Row="2" Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>

                                                <Button Content="Tümünü Seç"
                                                        Click="SelectGroupButton_Click"
                                                        Tag="{Binding}"
                                                        Foreground="{StaticResource Text}"
                                                        Background="#191816"
                                                        BorderBrush="{StaticResource Border}"
                                                        BorderThickness="1"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"/>

                                                <Button Grid.Column="2"
                                                        Content="Kaldır"
                                                        Click="ClearGroupButton_Click"
                                                        Tag="{Binding}"
                                                        Foreground="{StaticResource Text}"
                                                        Background="#191816"
                                                        BorderBrush="{StaticResource Border}"
                                                        BorderThickness="1"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ALT GENEL KOMUTLAR -->
                        <Border Grid.Row="1"
                                Background="#121310"
                                BorderBrush="#40331F"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Tüm Yetkileri Seç"
                                        Style="{StaticResource BottomButton}"
                                        Click="SelectAllButton_Click"/>

                                <Button Grid.Column="1"
                                        Content="Tüm Yetkileri Kaldır"
                                        Style="{StaticResource BottomButton}"
                                        Click="ClearAllButton_Click"/>

                                <TextBlock Grid.Column="3"
                                           Text="Değişiklikler Kaydet butonuna basıldığında uygulanır."
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource Muted}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ALT DURUM -->
            <Border Grid.Row="2"
                    Background="#111210"
                    BorderBrush="#40331F"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <TextBlock Text="●  Sistem hazır"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Success}"/>
                    <TextBlock Text="KaldiPOS v1.0.0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Muted}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
