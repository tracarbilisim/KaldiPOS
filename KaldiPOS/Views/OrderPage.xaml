<Page x:Class="KaldiPOS.Views.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#11100E">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="355" />
            </Grid.ColumnDefinitions>

            <!-- KATEGORİLER -->
            <Border Grid.Column="0"
                    Padding="12"
                    Background="#1A1815"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Kategoriler"
                               Margin="6,4,0,14"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FFFDF8" />

                    <StackPanel Grid.Row="1">
                        <Button Content="Tümü"
                                Tag="Tümü"
                                Margin="0,0,0,8"
                                Style="{StaticResource Button.Primary}"
                                Click="CategoryButton_Click" />

                        <Button Content="Sıcak İçecek"
                                Tag="Sıcak İçecek"
                                Margin="0,0,0,8"
                                Style="{StaticResource Button.Secondary}"
                                Click="CategoryButton_Click" />

                        <Button Content="Soğuk İçecek"
                                Tag="Soğuk İçecek"
                                Margin="0,0,0,8"
                                Style="{StaticResource Button.Secondary}"
                                Click="CategoryButton_Click" />

                        <Button Content="Kahvaltı"
                                Tag="Kahvaltı"
                                Margin="0,0,0,8"
                                Style="{StaticResource Button.Secondary}"
                                Click="CategoryButton_Click" />

                        <Button Content="Yiyecek"
                                Tag="Yiyecek"
                                Margin="0,0,0,8"
                                Style="{StaticResource Button.Secondary}"
                                Click="CategoryButton_Click" />

                        <Button Content="Tatlı"
                                Tag="Tatlı"
                                Style="{StaticResource Button.Secondary}"
                                Click="CategoryButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ÜRÜNLER -->
            <Border Grid.Column="1"
                    Margin="12,0"
                    Padding="16"
                    Background="#1A1815"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock x:Name="CategoryTitleText"
                                   Text="Tüm Ürünler"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFDF8" />

                        <TextBox x:Name="ProductSearchTextBox"
                                 Width="210"
                                 Height="36"
                                 Padding="12,7"
                                 HorizontalAlignment="Right"
                                 VerticalContentAlignment="Center"
                                 Background="#24211D"
                                 BorderBrush="#765A32"
                                 Foreground="#FFFDF8"
                                 CaretBrush="#FFFDF8"
                                 TextChanged="ProductSearchTextBox_TextChanged" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="ProductsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="150"
                                            Height="104"
                                            Margin="6"
                                            Padding="12"
                                            Tag="{Binding}"
                                            Style="{StaticResource Button.Secondary}"
                                            Click="ProductButton_Click">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Name}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding PriceText}"
                                                       Margin="0,8,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#E2BE79" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ADİSYON -->
            <Border Grid.Column="2"
                    Padding="16"
                    Background="#1A1815"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Adisyon"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFDF8" />

                            <TextBlock x:Name="OrderCountText"
                                       Text="0 ürün"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="#9D978D" />
                        </StackPanel>

                        <Button Content="Temizle"
                                Width="82"
                                Height="36"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Button.Danger}"
                                Click="ClearOrderButton_Click" />
                    </Grid>

                    <ListBox x:Name="OrderListBox"
                             Grid.Row="1"
                             Margin="0,15,0,12"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding OrderItems}">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="Margin"
                                        Value="0,0,0,8" />
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="BorderThickness"
                                        Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Background="#24211D"
                                        BorderBrush="#765A32"
                                        BorderThickness="1"
                                        CornerRadius="9">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFDF8" />

                                            <TextBlock Text="{Binding LineTotalText}"
                                                       Margin="0,4,0,0"
                                                       FontSize="13"
                                                       Foreground="#E2BE79" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Button Content="−"
                                                    Width="34"
                                                    Height="32"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource Button.Secondary}"
                                                    Click="DecreaseButton_Click" />

                                            <TextBlock Text="{Binding Quantity}"
                                                       Width="34"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFDF8" />

                                            <Button Content="+"
                                                    Width="34"
                                                    Height="32"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource Button.Secondary}"
                                                    Click="IncreaseButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Border Height="1"
                                Margin="0,0,0,14"
                                Background="#765A32" />

                        <Grid Margin="4,0,4,14">
                            <TextBlock Text="TOPLAM"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFDF8" />

                            <TextBlock x:Name="TotalText"
                                       Text="0,00 ₺"
                                       HorizontalAlignment="Right"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#5FB67A" />
                        </Grid>

                        <Button Content="Siparişi Gönder"
                                Height="52"
                                Margin="0,0,0,9"
                                Style="{StaticResource Button.Primary}"
                                Click="SendOrderButton_Click" />

                        <Button Content="Ödeme Al"
                                Height="48"
                                Style="{StaticResource Button.Secondary}"
                                Click="PaymentButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>