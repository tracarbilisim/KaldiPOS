<Page x:Class="KaldiPOS.Views.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#11100E">

    <Page.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="#FFFDF8"/>
            <Setter Property="Background" Value="#211E1A"/>
            <Setter Property="BorderBrush" Value="#765A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <TextBlock Text="{TemplateBinding Content}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextAlignment="Center"
           TextWrapping="NoWrap"
           TextTrimming="CharacterEllipsis"
           FontSize="12"
           FontWeight="Bold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30291F"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D0A354"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D0A354"/>
                                <Setter Property="Foreground" Value="#18140E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrderScrollBarThumb"
       TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                        Margin="1,2"
                        Background="#A97831"
                        CornerRadius="3"/>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                             Value="True">
                                <Setter TargetName="ThumbBorder"
                                Property="Background"
                                Value="#D4A64F"/>
                            </Trigger>

                            <Trigger Property="IsDragging"
                             Value="True">
                                <Setter TargetName="ThumbBorder"
                                Property="Background"
                                Value="#E8BD68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderVerticalScrollBar"
       TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="#1B1814"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8"
                      Background="{TemplateBinding Background}">

                            <Track x:Name="PART_Track"
                           Orientation="Vertical"
                           IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                          Opacity="0"
                                          Focusable="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb MinHeight="34"
                                   Style="{StaticResource OrderScrollBarThumb}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                          Opacity="0"
                                          Focusable="False"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ÜRÜN ÇALIŞMA ALANI -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KATEGORİLER -->
            <Border Grid.Row="0"
        Padding="10,7"
        Background="#171512"
        BorderBrush="#765A32"
        BorderThickness="1"
        CornerRadius="12">

                <Grid>
                    <WrapPanel x:Name="CategoryPanel"
               Orientation="Horizontal"
               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- ÜRÜN ARAMA -->
            <Border Grid.Row="2"
        Background="#171512"
        BorderBrush="#765A32"
        BorderThickness="1"
        CornerRadius="9">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⌕"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="22"
                   Foreground="#E2BE79"/>

                    <TextBox x:Name="ProductSearchTextBox"
                 Grid.Column="1"
                 Padding="0,0,12,0"
                 VerticalContentAlignment="Center"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#FFFDF8"
                 CaretBrush="#FFFDF8"
                 FontSize="13"
                 ToolTip="Ürün ara"
                 TextChanged="ProductSearchTextBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- ÜRÜNLER -->
            <Border Grid.Row="4"
                    Padding="12"
                    Background="#171512"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CategoryTitleText"
                               Text="Tüm Ürünler"
                               Margin="4,0,0,4"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFDF8"/>

                    <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
               BasedOn="{StaticResource OrderVerticalScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="ProductsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="136"
                                            Height="156"
                                            Margin="4"
                                            Padding="0"
                                            Tag="{Binding}"
                                            Background="#211E1A"
                                            BorderBrush="#765A32"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Click="ProductButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="CardScale"
                                                                        ScaleX="1"
                                                                        ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="94"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Margin="5"
                                                                Background="#12110F"
                                                                CornerRadius="7"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding ImagePath}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                                                        </Border>

                                                        <Grid Grid.Row="1" Margin="7,1,7,7">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFFDF8"/>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding PriceText}"
                                                                       Margin="0,2,0,0"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="#E2B85F"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#D0A354"/>
                                                        <Setter TargetName="Card" Property="Background" Value="#2B261E"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Card" Property="Opacity" Value="0.88"/>
                                                        <Setter TargetName="Card" Property="Background" Value="#3A3022"/>
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#E2B85F"/>
                                                        <Setter TargetName="Card"
                                                                Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.96"
                                                                ScaleY="0.96"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ADİSYON -->
        <Border Grid.Column="2"
                Padding="14"
                Background="#171512"
                BorderBrush="#765A32"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Adisyon"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#FFFDF8"/>
                        <TextBlock x:Name="OrderCountText"
                                   Text="0 ürün"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#BDB7AD"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Temizle"
                            Height="38"
                            Background="#D96267"
                            BorderBrush="#EA777C"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ClearOrderButton_Click"/>
                </Grid>

                <ListBox x:Name="OrderListBox"
         Grid.Row="1"
         Margin="0,8,0,10"
         Padding="0,0,4,0"
         ItemsSource="{Binding OrderItems}"
         Background="Transparent"
         BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.Resources>
                        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource OrderVerticalScrollBar}"/>
                    </ListBox.Resources>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="7,6"
                BorderThickness="1"
                CornerRadius="7">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#211E1A"/>
                                        <Setter Property="BorderBrush" Value="#4A3B25"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnsentItems}"
                                     Value="True">
                                                <Setter Property="Background" Value="#2C261C"/>
                                                <Setter Property="BorderBrush" Value="#B78638"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Üst satır -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Miktar -->
                                        <Border Grid.Column="0"
                            Height="27"
                            Background="#171512"
                            BorderBrush="#66502F"
                            BorderThickness="1"
                            CornerRadius="6">

                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−"
                                    Width="26"
                                    Height="25"
                                    MinWidth="26"
                                    Padding="0"
                                    Margin="0"
                                    Tag="{Binding}"
                                    FontSize="13"
                                    Style="{StaticResource CategoryButtonStyle}"
                                    Click="DecreaseButton_Click"/>

                                                <TextBlock Text="{Binding Quantity}"
                                       Width="25"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FFFDF8"/>

                                                <Button Content="+"
                                    Width="26"
                                    Height="25"
                                    MinWidth="26"
                                    Padding="0"
                                    Margin="0"
                                    Tag="{Binding}"
                                    FontSize="13"
                                    Style="{StaticResource CategoryButtonStyle}"
                                    Click="IncreaseButton_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ürün adı -->
                                        <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFDF8"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"/>

                                        <!-- Durum -->
                                        <Border Grid.Column="2"
                            MinWidth="64"
                            Height="20"
                            Padding="7,0"
                            VerticalAlignment="Center"
                            CornerRadius="10">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#31543B"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnsentItems}"
                                                 Value="True">
                                                            <Setter Property="Background"
                                                Value="#9B6A25"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding StatusText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Alt satır -->
                                    <Grid Grid.Row="1"
                      Margin="85,4,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding LineTotalText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#E2B85F"/>

                                            <TextBlock Text="{Binding NoteDisplay}"
                                   Margin="0,2,0,0"
                                   FontSize="9.5"
                                   FontStyle="Italic"
                                   Foreground="#BDB7AD"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NoteDisplay}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                            Content="Not"
                            Width="43"
                            Height="24"
                            Margin="6,0,0,0"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            Tag="{Binding}"
                            FontSize="9.5"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="NoteButton_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#604A29"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TOPLAM"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFDF8"/>
                    <TextBlock x:Name="TotalText"
                               Grid.Column="1"
                               Text="0,00 ₺"
                               VerticalAlignment="Center"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#58C878"/>
                </Grid>

                <Button Grid.Row="4"
        Height="38"
        Content="Siparişi Gönder"
        Background="#D0A354"
        BorderBrush="#E2B85F"
        Foreground="#18140E"
        Style="{StaticResource ActionButtonStyle}"
        Click="SendOrderButton_Click"/>

                <Button Grid.Row="6"
        Height="36"
        Content="Masayı Aktar"
        Background="#2A2722"
        BorderBrush="#765A32"
        Foreground="#E2BE79"
        Style="{StaticResource ActionButtonStyle}"
        Click="TransferTableButton_Click"/>

                <Button Grid.Row="8"
        Height="36"
        Content="Masa Birleştir"
        Background="#2A2722"
        BorderBrush="#8A5A3B"
        Foreground="#E2BE79"
        Style="{StaticResource ActionButtonStyle}"
        Click="MergeTableButton_Click"/>

                <Button Grid.Row="10"
        Height="36"
        Content="Ürün Aktar"
        Background="#2A2722"
        BorderBrush="#765A32"
        Foreground="#E2BE79"
        Style="{StaticResource ActionButtonStyle}"
        Click="TransferProductButton_Click"/>

                <Button Grid.Row="12"
        Height="38"
        Content="Ödeme Al"
        Background="#211E1A"
        BorderBrush="#765A32"
        Foreground="#FFFDF8"
        Style="{StaticResource ActionButtonStyle}"
        Click="PaymentButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
