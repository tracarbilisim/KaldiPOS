<Window x:Class="KaldiPOS.Views.TouchNumpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="430"
        Height="610"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="NumberButtonStyle"
               TargetType="Button">
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="FontSize"
                    Value="24"/>
            <Setter Property="FontWeight"
                    Value="ExtraBold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#2C2822"/>
            <Setter Property="BorderBrush"
                    Value="#765A32"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="48"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#493A2A"/>
            <Setter Property="BorderBrush"
                    Value="#765A32"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </Window.Resources>

    <Border Margin="10"
            Padding="20"
            CornerRadius="16"
            Background="#171512"
            BorderBrush="#9A7134"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="72"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Text="Tutar Girişi"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="✕"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#4A2727"
                        BorderBrush="#9A7134"
                        BorderThickness="1"
                        Click="CloseButton_Click"/>
            </Grid>

            <Border Grid.Row="2"
                    Padding="12"
                    Background="#29251F"
                    BorderBrush="#9A7134"
                    BorderThickness="1">

                <TextBlock x:Name="ValueTextBlock"
                           Text="0"
                           FontSize="32"
                           FontWeight="ExtraBold"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid Grid.Row="4">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Content="7"
                        Tag="7"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="8"
                        Tag="8"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="9"
                        Tag="9"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="1"
                        Grid.Column="0"
                        Content="4"
                        Tag="4"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="1"
                        Grid.Column="1"
                        Content="5"
                        Tag="5"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="6"
                        Tag="6"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="2"
                        Grid.Column="0"
                        Content="1"
                        Tag="1"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="2"
                        Grid.Column="1"
                        Content="2"
                        Tag="2"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Content="3"
                        Tag="3"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="3"
                        Grid.Column="0"
                        Content="00"
                        Tag="00"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button Grid.Row="3"
                        Grid.Column="1"
                        Content="0"
                        Tag="0"
                        Style="{StaticResource NumberButtonStyle}"
                        Click="NumberButton_Click"/>

                <Button x:Name="BackspaceButton"
                        Grid.Row="3"
                        Grid.Column="2"
                        Content="⌫"
                        FontSize="24"
                        FontWeight="ExtraBold"
                        Foreground="White"
                        Background="#4A2727"
                        BorderBrush="#765A32"
                        BorderThickness="1"
                        Margin="5"
                        Click="BackspaceButton_Click"/>
            </Grid>

            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DecimalButton"
                        Content=","
                        Style="{StaticResource ActionButtonStyle}"
                        Click="DecimalButton_Click"/>

                <Button x:Name="ClearButton"
                        Grid.Column="2"
                        Content="Temizle"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="ClearButton_Click"/>
            </Grid>

            <Grid Grid.Row="8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton"
                        Content="Vazgeç"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#493A2A"
                        BorderBrush="#9A7134"
                        BorderThickness="1"
                        Click="CancelButton_Click"/>

                <Button x:Name="OkButton"
                        Grid.Column="2"
                        Content="Tamam"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="Black"
                        Background="#D4A64F"
                        BorderBrush="#9A7134"
                        BorderThickness="1"
                        Click="OkButton_Click"/>
            </Grid>

        </Grid>
    </Border>
</Window>