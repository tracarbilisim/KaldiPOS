<Page x:Class="KaldiPOS.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#171512">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Satış Raporları"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Kapanan adisyonları ve ödeme toplamlarını görüntüleyin"
                           Margin="0,4,0,0"
                           Foreground="#AFA89D"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <DatePicker x:Name="ReportDatePicker"
                            Width="175"
                            Height="40"
                            FontSize="15"
                            SelectedDateChanged="ReportDatePicker_SelectedDateChanged"/>

                <Button Content="Yenile"
                        Width="105"
                        Height="40"
                        Margin="10,0,0,0"
                        Click="RefreshButton_Click"
                        Background="#D4A64F"
                        Foreground="#171512"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">
                <StackPanel>
                    <TextBlock Text="ADİSYON"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="OrderCountText"
                               Margin="0,7,0,0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">
                <StackPanel>
                    <TextBlock Text="TOPLAM CİRO"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="RevenueText"
                               Margin="0,7,0,0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#56D47E"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="8,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">
                <StackPanel>
                    <TextBlock Text="NAKİT"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CashText"
                               Margin="0,7,0,0"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Margin="8,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">
                <StackPanel>
                    <TextBlock Text="KART"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CardText"
                               Margin="0,7,0,0"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#69A6F3"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Margin="8,0,0,0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    Background="#211E1A">
                <StackPanel>
                    <TextBlock Text="KARMA"
                               Foreground="#AAA297"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="MixedText"
                               Margin="0,7,0,0"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#D59B4B"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                CornerRadius="12"
                BorderBrush="#765A32"
                BorderThickness="1"
                Background="#1D1A17"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="KAPANAN ADİSYONLAR"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#D4A64F"
                           Margin="2,0,0,12"/>

                <ListView x:Name="OrdersListView"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          Foreground="White"
          MouseDoubleClick="OrdersListView_MouseDoubleClick"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Margin"
                                    Value="0,0,0,7"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15"
                                    CornerRadius="8"
                                    Background="#29251F"
                                    BorderBrush="#554225"
                                    BorderThickness="1">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding TimeText}"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#D4A64F"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TableName}"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PaymentType}"
                                               VerticalAlignment="Center"
                                               Foreground="#C9C2B7"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding AmountText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#56D47E"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="1"
                           Text="Seçilen tarihte kapanmış adisyon bulunmuyor."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#8F887F"
                           FontSize="16"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>