<Window x:Class="KaldiPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KaldiPOS"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="{StaticResource Brush.Background}"
        KeyDown="Window_KeyDown">

    <Grid>
        <Image Source="/Assets/login-background.png"
               Stretch="UniformToFill" />

        <Rectangle Fill="#7A000000" />

        <Border Margin="18"
                BorderBrush="{StaticResource Brush.GoldDark}"
                BorderThickness="1"
                CornerRadius="16" />

        <Grid Margin="38,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <!-- Marka alanı -->
                <StackPanel Grid.Column="0"
                            Width="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/kaldi-logo.png"
                           Width="410"
                           Height="190"
                           Stretch="Uniform" />

                    <Border Width="330"
                            Height="1"
                            Margin="0,18,0,24"
                            Background="{StaticResource Brush.GoldDark}" />

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.White}">
                        <Run Text="Kaldi" />
                        <Run Text="POS"
                             Foreground="{StaticResource Brush.GoldLight}" />
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="19"
                               Foreground="{StaticResource Brush.LightText}"
                               Text="Profesyonel Restoran Otomasyonu" />

                    <TextBlock Margin="0,34,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               Foreground="{StaticResource Brush.Gray}"
                               Text="Designed &amp; Developed by Berkan ACAR" />
                </StackPanel>

                <!-- Giriş kartı -->
                <Border Grid.Column="1"
                        Width="360"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource Card.Glass}">

                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.White}"
                                   Text="Personel Girişi" />

                        <TextBlock Margin="0,8,0,18"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.Gray}"
                                   Text="Giriş yapmak için şifrenizi girin" />

                        <StackPanel x:Name="PinIndicatorPanel"
                                    Margin="0,0,0,18"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">

                            <Ellipse x:Name="PinDot1"
                                     Width="13"
                                     Height="13"
                                     Margin="7"
                                     Fill="{StaticResource Brush.Gray}" />

                            <Ellipse x:Name="PinDot2"
                                     Width="13"
                                     Height="13"
                                     Margin="7"
                                     Fill="{StaticResource Brush.Gray}" />

                            <Ellipse x:Name="PinDot3"
                                     Width="13"
                                     Height="13"
                                     Margin="7"
                                     Fill="{StaticResource Brush.Gray}" />

                            <Ellipse x:Name="PinDot4"
                                     Width="13"
                                     Height="13"
                                     Margin="7"
                                     Fill="{StaticResource Brush.Gray}" />
                        </StackPanel>

                        <UniformGrid Columns="3" Rows="4">
                            <Button Content="1" Tag="1"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="2" Tag="2"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="3" Tag="3"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="4" Tag="4"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="5" Tag="5"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="6" Tag="6"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="7" Tag="7"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="8" Tag="8"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="9" Tag="9"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="✕"
                                    Foreground="{StaticResource Brush.Danger}"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="ClearButton_Click" />

                            <Button Content="0" Tag="0"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="NumberButton_Click" />

                            <Button Content="↵"
                                    Foreground="{StaticResource Brush.Success}"
                                    Style="{StaticResource Button.Keypad}"
                                    Click="LoginButton_Click" />
                        </UniformGrid>

                        <TextBlock x:Name="StatusText"
                                   MinHeight="20"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource Brush.Danger}"
                                   TextAlignment="Center" />

                        <Button Height="54"
                                Margin="5,12,5,0"
                                Content="Kullanıcı Girişi"
                                Style="{StaticResource Button.Primary}"
                                Click="LoginButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alt durum alanı -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Success}" />

                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource Brush.LightText}"
                               Text="Sistem Hazır" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource Brush.Gray}"
                           Text="v1.0.0" />
            </Grid>
        </Grid>
    </Grid>
</Window>