<Page x:Class="KaldiPOS.Views.CurrentAccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#171512">

    <Page.Resources>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
            <Setter Property="Foreground"
                    Value="#BDB5AA"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldTextBox"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Padding"
                    Value="12,8"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#29251F"/>
            <Setter Property="BorderBrush"
                    Value="#765A32"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Padding"
                    Value="18,0"/>
            <Setter Property="Foreground"
                    Value="#17130E"/>
            <Setter Property="Background"
                    Value="#D4A64F"/>
            <Setter Property="BorderBrush"
                    Value="#F0C66F"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Padding"
                    Value="18,0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#29251F"/>
            <Setter Property="BorderBrush"
                    Value="#765A32"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="CurrentAccountDataGrid"
               TargetType="DataGrid">
            <Setter Property="Background"
                    Value="#1D1A17"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#765A32"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="RowBackground"
                    Value="#211E1A"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#29251F"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#493A27"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="#493A27"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="AutoGenerateColumns"
                    Value="False"/>
            <Setter Property="CanUserAddRows"
                    Value="False"/>
            <Setter Property="CanUserDeleteRows"
                    Value="False"/>
            <Setter Property="CanUserResizeRows"
                    Value="False"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>
            <Setter Property="SelectionMode"
                    Value="Single"/>
            <Setter Property="SelectionUnit"
                    Value="FullRow"/>
            <Setter Property="RowHeight"
                    Value="46"/>
            <Setter Property="ColumnHeaderHeight"
                    Value="44"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#302719"/>
            <Setter Property="Foreground"
                    Value="#E8BD68"/>
            <Setter Property="BorderBrush"
                    Value="#765A32"/>
            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#493A27"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#332A20"/>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#5C4729"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>

    </Page.Resources>

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst başlık -->
        <Border Grid.Row="0"
        Padding="16,8"
        Background="#1D1A17"
        BorderBrush="#765A32"
        BorderThickness="1"
        CornerRadius="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="CARİ HESAPLAR"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Müşteri borç, tahsilat ve bakiye takibi"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#918A80"/>
                </StackPanel>

                <Button x:Name="NewCurrentAccountButton"
                               Grid.Column="1"
                               Width="145"
                               Height="36"
                               Content="+ Yeni Cari"
                               Style="{StaticResource ActionButton}"
                               Click="NewCurrentAccountButton_Click"/>
            </Grid>
        </Border>

        <!-- Ana bölüm -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Sol liste -->
            <Border Grid.Column="0"
                    Padding="16"
                    Background="#1D1A17"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Height="42"
                                 Padding="12,8"
                                 FontSize="14"
                                 Foreground="White"
                                 CaretBrush="White"
                                 Background="#29251F"
                                 BorderBrush="#765A32"
                                 BorderThickness="1"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <CheckBox x:Name="ShowPassiveCheckBox"
                                  Grid.Column="2"
                                  Content="Pasif carileri göster"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Cursor="Hand"
                                  Checked="ShowPassiveCheckBox_Changed"
                                  Unchecked="ShowPassiveCheckBox_Changed"/>
                    </Grid>

                    <DataGrid x:Name="CurrentAccountsDataGrid"
                              Grid.Row="2"
                              Style="{StaticResource CurrentAccountDataGrid}"
                              SelectionChanged="CurrentAccountsDataGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Cari Adı"
                                                Binding="{Binding Name}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Telefon"
                                                Binding="{Binding PhoneText}"
                                                Width="1.3*"/>

                            <DataGridTextColumn Header="Bakiye"
                                                Binding="{Binding BalanceText}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="Durum"
                                                Binding="{Binding StatusText}"
                                                Width="0.8*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Sağ form -->
            <Border Grid.Column="2"
                    Padding="12,10"
                    Background="#1D1A17"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CurrentAccountFormTitleText"
               Grid.Row="0"
               Text="Yeni Cari"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#D4A64F"/>

                    <TextBlock Grid.Row="2"
               Text="Cari Adı"
               Style="{StaticResource FieldLabel}"
               Margin="0"/>

                    <TextBox x:Name="CurrentAccountNameTextBox"
             Grid.Row="3"
             Height="30"
             Padding="10,5"
             FontSize="14"
             Foreground="White"
             CaretBrush="White"
             Background="#29251F"
             BorderBrush="#765A32"
             BorderThickness="1"/>

                    <TextBlock Grid.Row="4"
               Text="Telefon"
               Style="{StaticResource FieldLabel}"
               Margin="0,6,0,0"/>

                    <TextBox x:Name="CurrentAccountPhoneTextBox"
             Grid.Row="5"
             Height="30"
             Padding="10,5"
             FontSize="14"
             Foreground="White"
             CaretBrush="White"
             Background="#29251F"
             BorderBrush="#765A32"
             BorderThickness="1"/>

                    <TextBlock Grid.Row="6"
               Text="Açıklama"
               Style="{StaticResource FieldLabel}"
               Margin="0,6,0,0"/>

                    <TextBox x:Name="CurrentAccountDescriptionTextBox"
             Grid.Row="7"
             Height="54"
             Padding="10,7"
             FontSize="13"
             Foreground="White"
             CaretBrush="White"
             Background="#29251F"
             BorderBrush="#765A32"
             BorderThickness="1"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"/>

                    <Button x:Name="SaveCurrentAccountButton"
            Grid.Row="9"
            Height="36"
            Content="Cariyi Kaydet"
            Style="{StaticResource ActionButton}"
            Click="SaveCurrentAccountButton_Click"/>

                    <Button x:Name="ToggleCurrentAccountStatusButton"
            Grid.Row="11"
            Height="36"
            Content="Cariyi Pasifleştir"
            Style="{StaticResource SecondaryButton}"
            Visibility="Collapsed"
            Click="ToggleCurrentAccountStatusButton_Click"/>

                    <Border Grid.Row="13"
            Height="1"
            Background="#493A27"/>

                    <TextBlock Grid.Row="15"
               Text="Cari İşlemleri"
               FontSize="15"
               FontWeight="Bold"
               Foreground="White"/>

                    <TextBlock x:Name="SelectedCurrentAccountInfoText"
               Grid.Row="16"
               Text="İşlem yapmak için listeden bir cari seçin."
               Margin="0,3,0,8"
               FontSize="12"
               Foreground="#918A80"
               TextWrapping="Wrap"/>

                    <Button x:Name="AddDebtButton"
            Grid.Row="17"
            Height="36"
            Content="Borç Ekle"
            Style="{StaticResource SecondaryButton}"
            IsEnabled="False"
            Click="AddDebtButton_Click"/>

                    <Button x:Name="AddCollectionButton"
            Grid.Row="19"
            Height="36"
            Content="Tahsilat Yap"
            Style="{StaticResource SecondaryButton}"
            IsEnabled="False"
            Click="AddCollectionButton_Click"/>

                    <Button x:Name="ViewTransactionsButton"
            Grid.Row="21"
            Height="36"
            Content="Hareket Geçmişi"
            Style="{StaticResource SecondaryButton}"
            IsEnabled="False"
            Click="ViewTransactionsButton_Click"/>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>