<Window x:Class="KaldiPOS.Views.TouchKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="860"
        Height="560"
        ShowInTaskbar="False">

    <Border Margin="12"
            CornerRadius="16"
            Background="#171512"
            BorderBrush="#9A7134"
            BorderThickness="1">

        <Grid Margin="24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>

                <RowDefinition Height="52"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="56"/>

            </Grid.RowDefinitions>

            <!-- BAŞLIK -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>
                    <ColumnDefinition Width="60"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleTextBlock"
                    Text="Ekran Klavyesi"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center"/>

                <Button
                    Grid.Column="1"
                    x:Name="CloseButton"
                    Content="✕"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#4A2727"
                    Foreground="White"
                    BorderBrush="#9A7134"
                    BorderThickness="1"/>

            </Grid>

            <!-- GİRİŞ -->

            <TextBox
                Grid.Row="2"
                x:Name="InputTextBox"
                FontSize="20"
                FontWeight="SemiBold"
                Padding="12,6"
                Background="#29251F"
                Foreground="White"
                CaretBrush="White"
                BorderBrush="#9A7134"
                BorderThickness="1"/>

            <!-- TUŞLAR -->

            <StackPanel
    Grid.Row="4"
    x:Name="KeyboardGrid"/>

            <!-- ALT BUTONLAR -->

            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>

                <Button
                    x:Name="CancelButton"
                    Content="Vazgeç"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#493A2A"
                    Foreground="White"
                    BorderBrush="#9A7134"
                    BorderThickness="1"/>

                <Button
                    Grid.Column="2"
                    x:Name="OkButton"
                    Content="Tamam"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#D4A64F"
                    Foreground="Black"
                    BorderBrush="#9A7134"
                    BorderThickness="1"/>

            </Grid>

        </Grid>

    </Border>

</Window>