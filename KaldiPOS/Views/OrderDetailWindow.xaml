<Window x:Class="KaldiPOS.Views.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adisyon Detayı"
        Width="580"
        Height="670"
        MinWidth="580"
        MinHeight="670"
        MaxWidth="580"
        MaxHeight="670"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4A64F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3022"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#594429"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="FooterButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="105"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#302B25"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#765A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#423722"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D4A64F"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#594429"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Border Margin="8"
            CornerRadius="14"
            Background="#1B1916"
            BorderBrush="#A37A35"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="0"
                              Opacity="0.65"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- Özel Başlık Alanı -->
            <Border Grid.Row="0"
                    Background="#211E1A"
                    CornerRadius="13,13,0,0"
                    BorderBrush="#4B3A21"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0,14,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="OrderTitleText"
                                   Text="Adisyon Detayı"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="OrderSubTitleText"
                                   Text="Kapanmış adisyon bilgileri"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#9E968B"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="13,6"
                            VerticalAlignment="Center"
                            CornerRadius="7"
                            Background="#332A1D"
                            BorderBrush="#765A32"
                            BorderThickness="1">

                        <TextBlock x:Name="PaymentTypeText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                    </Border>

                    <Button Grid.Column="2"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}"/>

                </Grid>

            </Border>

            <!-- Adisyon Bilgileri -->
            <Border Grid.Row="1"
                    Margin="18,14,18,12"
                    Padding="14"
                    CornerRadius="9"
                    Background="#27231E"
                    BorderBrush="#514022"
                    BorderThickness="1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="MASA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#938B80"/>

                        <TextBlock x:Name="TableNameText"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="ADİSYON"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#938B80"/>

                        <TextBlock x:Name="OrderNumberText"
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="AÇILIŞ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#938B80"/>

                        <TextBlock x:Name="OpenedAtText"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="#D4CEC5"/>

                    </StackPanel>

                    <StackPanel Grid.Column="3">

                        <TextBlock Text="KAPANIŞ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#938B80"/>

                        <TextBlock x:Name="ClosedAtText"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="#D4CEC5"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Ürünler -->
            <Border Grid.Row="2"
                    Margin="18,0,18,0"
                    CornerRadius="9"
                    Background="#211E1A"
                    BorderBrush="#514022"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#29251F"
                            CornerRadius="8,8,0,0">

                        <Grid Margin="13,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="ADET"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#938B80"/>

                            <TextBlock Grid.Column="1"
                                       Text="ÜRÜN"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#938B80"/>

                            <TextBlock Grid.Column="2"
                                       Text="BİRİM FİYAT"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#938B80"/>

                            <TextBlock Grid.Column="3"
                                       Text="TUTAR"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#938B80"/>

                        </Grid>

                    </Border>

                    <ListView x:Name="ItemsListView"
                              Grid.Row="1"
                              Margin="7"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                <Setter Property="Padding"
                                        Value="0"/>

                                <Setter Property="Margin"
                                        Value="0,0,0,3"/>

                                <Setter Property="Background"
                                        Value="Transparent"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="Focusable"
                                        Value="False"/>

                            </Style>

                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="10,8"
                                        CornerRadius="6"
                                        Background="#29251F">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding QuantityText}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="#D4A64F"/>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="{Binding ProductName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>

                                            <TextBlock Text="{Binding Note}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#AAA297"/>

                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UnitPriceText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#C9C2B7"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding LineTotalText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#56D47E"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

            <!-- Ödeme Detayları -->
            <Border Grid.Row="3"
        Margin="18,12,18,0"
        CornerRadius="9"
        Background="#211E1A"
        BorderBrush="#514022"
        BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#29251F"
                CornerRadius="8,8,0,0">

                        <Grid Margin="13,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="ÖDEME TÜRÜ"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#938B80"/>

                            <TextBlock Grid.Column="1"
                           Text="AÇIKLAMA / ÜRÜNLER"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#938B80"/>

                            <TextBlock Grid.Column="2"
                           Text="SAAT"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#938B80"/>

                            <TextBlock Grid.Column="3"
                           Text="TUTAR"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#938B80"/>

                        </Grid>

                    </Border>

                    <ListView x:Name="PaymentsListView"
                  Grid.Row="1"
                  Margin="7"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                                <Setter Property="Padding"
                            Value="0"/>
                                <Setter Property="Margin"
                            Value="0,0,0,4"/>
                                <Setter Property="Background"
                            Value="Transparent"/>
                                <Setter Property="BorderThickness"
                            Value="0"/>
                                <Setter Property="Focusable"
                            Value="False"/>
                            </Style>

                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="10,5"
                                        CornerRadius="6"
                                        Background="#29251F">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding PaymentType}"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#D4A64F"/>

                                        <TextBlock Grid.Column="1"
                                       Text="{Binding DescriptionText}"
                                       Margin="6,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#C9C2B7"/>

                                        <TextBlock Grid.Column="2"
                                       Text="{Binding CreatedAtText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#AAA297"/>

                                        <TextBlock Grid.Column="3"
                                       Text="{Binding AmountText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#56D47E"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

            <!-- Alt Alan -->
            <Grid Grid.Row="4"
                  Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Kapat"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        Style="{StaticResource FooterButtonStyle}"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="GENEL TOPLAM"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#AAA297"/>

                    <TextBlock x:Name="TotalAmountText"
                               VerticalAlignment="Center"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#56D47E"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>