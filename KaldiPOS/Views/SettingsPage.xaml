<Page x:Class="KaldiPOS.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#171512">

    <Page.Resources>
        <Style x:Key="SettingsMenuButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#211E1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#765A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#29251F"/>
            <Setter Property="BorderBrush" Value="#765A32"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#BDB5AA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PermissionCheckBox"
       TargetType="CheckBox">

            <Setter Property="Foreground"
            Value="#F4F0E8"/>

            <Setter Property="FontSize"
            Value="13"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Margin"
            Value="0,3"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowBorder"
                        Background="#211E1A"
                        BorderBrush="#493A27"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="9,7">
                        
                            <Grid>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CheckBoxBorder"
                                Width="17"
                                Height="17"
                                Background="#171512"
                                BorderBrush="#8D6A36"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center">

                                    <Path x:Name="CheckMark"
                                  Data="M 3 8 L 7 12 L 14 4"
                                  Stroke="#171512"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                          Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                             Value="True">
                                <Setter TargetName="RowBorder"
                                Property="Background"
                                Value="#2A251F"/>
                                <Setter TargetName="RowBorder"
                                Property="BorderBrush"
                                Value="#8D6A36"/>
                            </Trigger>

                            <Trigger Property="IsChecked"
                             Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                Property="Background"
                                Value="#D9A94D"/>
                                <Setter TargetName="CheckBoxBorder"
                                Property="BorderBrush"
                                Value="#F0C66F"/>
                                <Setter TargetName="CheckMark"
                                Property="Visibility"
                                Value="Visible"/>
                                <Setter TargetName="RowBorder"
                                Property="Background"
                                Value="#302719"/>
                                <Setter TargetName="RowBorder"
                                Property="BorderBrush"
                                Value="#B1843E"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">
                                <Setter TargetName="RowBorder"
                                Property="Opacity"
                                Value="0.48"/>
                                <Setter Property="Cursor"
                                Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionScrollBar"
       TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8"
                      Background="#1B1814">

                            <Track x:Name="PART_Track"
                           Orientation="Vertical"
                           IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="6"
                                   Margin="1,2"
                                   Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                Background="#9A7338"
                                                CornerRadius="3"/>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#D4A64F"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                     Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#E8BD68"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="14"
                CornerRadius="12"
                Background="#1D1A17"
                BorderBrush="#765A32"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="4,2,4,18">
                    <TextBlock Text="AYARLAR"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                    <TextBlock Text="Sistem yapılandırması"
                               Margin="0,4,0,0"
                               Foreground="#918A80"/>
                </StackPanel>

                <StackPanel x:Name="SettingsMenuPanel"
                            Grid.Row="1">
                    <Button x:Name="BusinessSettingsMenuButton"
                            Content="🏪  İşletme Bilgileri"
                            Tag="Business"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="◷  İş Günü Ayarları"
                            Tag="DayEnd"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="🖨  Yazıcı Ayarları"
                            Tag="Printers"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="👤  Kullanıcılar"
                            Tag="Users"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="💾  Yedekleme"
                            Tag="Backup"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="ℹ  Program Hakkında"
                            Tag="About"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="24"
                CornerRadius="12"
                Background="#1D1A17"
                BorderBrush="#765A32"
                BorderThickness="1">

            <Grid>
        
        <!-- İŞLETME -->
                <Grid x:Name="BusinessPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="İşletme Bilgileri"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Fişlerde ve program içinde kullanılacak bilgiler"
                                   Margin="0,5,0,0"
                                   Foreground="#AFA89D"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,25,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="İşletme Adı"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="BusinessNameTextBox"
                                     Style="{StaticResource FieldTextBox}"/>

                            <TextBlock Text="Telefon"
                                       Margin="0,18,0,6"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="PhoneTextBox"
                                     Style="{StaticResource FieldTextBox}"/>

                            <TextBlock Text="Vergi Dairesi"
                                       Margin="0,18,0,6"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TaxOfficeTextBox"
                                     Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Adres"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="AddressTextBox"
                                     Height="102"
                                     Padding="12,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="White"
                                     Background="#29251F"
                                     BorderBrush="#765A32"
                                     BorderThickness="1"
                                     FontSize="15"/>

                            <TextBlock Text="Vergi / T.C. Numarası"
                                       Margin="0,18,0,6"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TaxNumberTextBox"
                                     Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="2"
                            Content="Bilgileri Kaydet"
                            Width="170"
                            Height="44"
                            HorizontalAlignment="Right"
                            Click="SaveBusinessButton_Click"
                            Background="#D4A64F"
                            Foreground="#171512"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>

                <!-- İŞ GÜNÜ -->
                <Grid x:Name="DayEndSettingsPanel"
      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="İş Günü Ayarları"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"/>

                        <TextBlock Text="Otomatik gün sonu saatini ve açık adisyonların davranışını yönetin"
                   Margin="0,5,0,0"
                   Foreground="#AFA89D"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                Margin="0,25,0,0"
                Width="620"
                HorizontalAlignment="Left">

                        <Border Padding="20"
                CornerRadius="10"
                Background="#29251F"
                BorderBrush="#765A32"
                BorderThickness="1">

                            <StackPanel>
                                <CheckBox x:Name="AutomaticDayEndCheckBox"
                          Content="Otomatik gün sonunu etkinleştir"
                          Style="{StaticResource PermissionCheckBox}"
                          IsChecked="True"/>

                                <TextBlock Text="Gün Sonu Saati"
                           Margin="0,20,0,6"
                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="AutomaticDayEndTimeTextBox"
                         Width="150"
                         HorizontalAlignment="Left"
                         Text="23:55"
                         MaxLength="5"
                         Style="{StaticResource FieldTextBox}"/>

                                <TextBlock Text="Saati 24 saat biçiminde girin. Örnek: 23:55 veya 02:30"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#918A80"/>

                                <CheckBox x:Name="CarryOpenOrdersCheckBox"
                          Content="Açık adisyonları kapatmadan yeni iş gününe devret"
                          Margin="0,20,0,0"
                          Style="{StaticResource PermissionCheckBox}"
                          IsChecked="True"/>

                                <CheckBox x:Name="DayEndWarningCheckBox"
                          Content="Otomatik gün sonundan önce uyarı göster"
                          Margin="0,8,0,0"
                          Style="{StaticResource PermissionCheckBox}"
                          IsChecked="True"/>

                                <TextBlock Text="Uyarı Süresi (Dakika)"
                           Margin="0,20,0,6"
                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="DayEndWarningMinutesTextBox"
                         Width="150"
                         HorizontalAlignment="Left"
                         Text="5"
                         MaxLength="2"
                         Style="{StaticResource FieldTextBox}"/>

                                <Border Margin="0,22,0,0"
                        Padding="14"
                        CornerRadius="8"
                        Background="#211E1A"
                        BorderBrush="#554225"
                        BorderThickness="1">

                                    <TextBlock Text="Otomatik gün sonunda tamamlanmış satışlar kapatılır. Açık masalar ve ürünleri korunarak yeni iş gününe aktarılır."
                               TextWrapping="Wrap"
                               Foreground="#C4BDB3"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
            Content="İş Günü Ayarlarını Kaydet"
            Width="220"
            Height="44"
            HorizontalAlignment="Right"
            Click="SaveDayEndSettingsButton_Click"
            Background="#D4A64F"
            Foreground="#171512"
            BorderThickness="0"
            FontWeight="Bold"
            Cursor="Hand"/>
                </Grid>

                <!-- YAZICILAR -->
                <Grid x:Name="PrintersPanel"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Yazıcı Ayarları"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Hazırlama fişlerinin gönderileceği yazıcıları belirleyin"
                                   Margin="0,5,0,0"
                                   Foreground="#AFA89D"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,25,0,0"
                                MaxWidth="620"
                                HorizontalAlignment="Left">

                        <TextBlock Text="Mutfak Yazıcısı"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="KitchenPrinterTextBox"
                                 Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="Bar Yazıcısı"
                                   Margin="0,18,0,6"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="BarPrinterTextBox"
                                 Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="Kasa / Adisyon Yazıcısı"
                                   Margin="0,18,0,6"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="CashierPrinterTextBox"
                                 Style="{StaticResource FieldTextBox}"/>

                        <Border Margin="0,24,0,0"
                                Padding="14"
                                CornerRadius="8"
                                Background="#29251F"
                                BorderBrush="#554225"
                                BorderThickness="1">

                            <TextBlock Text="Yazıcı adlarını Windows → Ayarlar → Yazıcılar ekranında göründüğü şekilde yazın."
                                       TextWrapping="Wrap"
                                       Foreground="#BDB5AA"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Yazıcıları Kaydet"
                            Width="170"
                            Height="44"
                            HorizontalAlignment="Right"
                            Click="SavePrintersButton_Click"
                            Background="#D4A64F"
                            Foreground="#171512"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>

                <!-- KULLANICILAR -->
                <Grid x:Name="UsersPanel"
      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Kullanıcı ve Yetki Yönetimi"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>

                            <TextBlock Text="Personel hesaplarını, rollerini ve işlem yetkilerini yönetin"
                       Margin="0,5,0,0"
                       Foreground="#AFA89D"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                Content="+ Yeni Kullanıcı"
                Width="150"
                Height="42"
                Click="NewUserButton_Click"
                Background="#D4A64F"
                Foreground="#171512"
                BorderThickness="0"
                FontWeight="Bold"
                Cursor="Hand"/>
                    </Grid>

                    <Grid Grid.Row="1"
          Margin="0,24,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KULLANICI LİSTESİ -->
                        <Border Padding="1"
                CornerRadius="10"
                Background="#765A32">

                            <DataGrid x:Name="UsersDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionChanged="UsersDataGrid_SelectionChanged"
                      Background="#211E1A"
                      Foreground="White"
                      BorderThickness="0"
                      RowBackground="#211E1A"
                      AlternatingRowBackground="#29251F"
                      HorizontalGridLinesBrush="#3C342A"
                      VerticalGridLinesBrush="#3C342A">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Height" Value="42"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="Background" Value="#29251F"/>
                                        <Setter Property="Foreground" Value="#D4A64F"/>
                                        <Setter Property="BorderBrush" Value="#554225"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>

                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush"
                                Value="#3C342A"/>
                                        <Setter Property="Foreground"
                                Value="White"/>
                                    </Style>

                                    <Style TargetType="DataGridRow">
                                        <Setter Property="MinHeight" Value="44"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kullanıcı"
                                        Binding="{Binding FullName}"
                                        Width="*"/>

                                    <DataGridTextColumn Header="Rol"
                                        Binding="{Binding Role}"
                                        Width="95"/>

                                    <DataGridTextColumn Header="Durum"
                                        Binding="{Binding StatusText}"
                                        Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- KULLANICI FORMU -->
                        <Border Grid.Column="2"
                Padding="18"
                CornerRadius="10"
                Background="#29251F"
                BorderBrush="#765A32"
                BorderThickness="1">

                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="UserFormTitleText"
                               Text="Yeni Kullanıcı"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                                    <TextBlock Text="Ad Soyad"
                               Margin="0,22,0,6"
                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox x:Name="UserFullNameTextBox"
                             Style="{StaticResource TextBox.Kaldi}"
                             MaxLength="80"/>

                                    <TextBlock Text="PIN (Minimum 4 Hane)"
                               Margin="0,18,0,6"
                               Style="{StaticResource FieldLabel}"/>

                                    <PasswordBox x:Name="UserPinPasswordBox"
                                 Style="{StaticResource PasswordBox.Kaldi}"
                                 MaxLength="32"
                                 PreviewTextInput=
                                 "UserPinPasswordBox_PreviewTextInput"/>

                                    <TextBlock Text="Düzenlemede PIN değişmeyecekse boş bırakın."
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#918A80"/>

                                    <TextBlock Text="Rol"
                               Margin="0,14,0,4"
                               Style="{StaticResource FieldLabel}"/>

                                    <ComboBox x:Name="UserRoleComboBox"
                              Style="{StaticResource ComboBox.Kaldi}"
                              SelectedIndex="2">

                                        <ComboBoxItem Content="Yönetici"/>
                                        <ComboBoxItem Content="Kasiyer"/>
                                        <ComboBoxItem Content="Garson"/>
                                    </ComboBox>

                                    <Button x:Name="SaveUserButton"
                            Content="Kullanıcıyı Kaydet"
                            Height="40"
                            Margin="0,18,0,0"
                            Click="SaveUserButton_Click"
                            Background="#D4A64F"
                            Foreground="#171512"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                                    <Button x:Name="ToggleUserStatusButton"
                            Content="Kullanıcıyı Pasifleştir"
                            Height="38"
                            Margin="0,8,0,0"
                            Visibility="Collapsed"
                            Click="ToggleUserStatusButton_Click"
                            Background="#7D3C3C"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                                    <Button Content="Formu Temizle"
                            Height="36"
                            Margin="0,8,0,0"
                            Click="NewUserButton_Click"
                            Background="#3A342D"
                            Foreground="White"
                            BorderBrush="#765A32"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- YETKİLER -->
                        <Border Grid.Column="4"
                Padding="18"
                CornerRadius="10"
                Background="#29251F"
                BorderBrush="#765A32"
                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Kullanıcı Yetkileri"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                                    <TextBlock x:Name="PermissionInfoText"
                               Text="Yetkileri düzenlemek için listeden kullanıcı seçin."
                               Margin="0,5,0,12"
                               TextWrapping="Wrap"
                               Foreground="#AFA89D"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="Tümünü Seç"
                                Height="34"
                                Click="SelectAllPermissionsButton_Click"
                                Background="#3A342D"
                                Foreground="White"
                                BorderBrush="#765A32"
                                BorderThickness="1"
                                Cursor="Hand"/>

                                        <Button Grid.Column="2"
                                Content="Tümünü Kaldır"
                                Height="34"
                                Click="ClearAllPermissionsButton_Click"
                                Background="#3A342D"
                                Foreground="White"
                                BorderBrush="#765A32"
                                BorderThickness="1"
                                Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
              Margin="0,14,0,14"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource PermissionScrollBar}"/>
                                    </ScrollViewer.Resources>

                                    <StackPanel x:Name="PermissionsPanel"
                                IsEnabled="False">

                                        <TextBlock Text="SİPARİŞ İŞLEMLERİ"
                                                   Margin="0,18,0,8"
                                                   FontSize="15"                
                                                   FontWeight="Bold"
                                                   Foreground="#D4A64F"/>

                                        <CheckBox Content="Ürün ekleme"
                                                   Style="{StaticResource PermissionCheckBox}"
                                  Tag="Order.AddItem"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ürün silme"
                                                   Style="{StaticResource PermissionCheckBox}"
                                  Tag="Order.RemoveItem"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ürün adedini artırma"
                                                   Style="{StaticResource PermissionCheckBox}"
