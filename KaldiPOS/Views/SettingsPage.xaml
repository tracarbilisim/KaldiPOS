<Page x:Class="KaldiPOS.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#171512">

    <Page.Resources>
        <Style x:Key="SettingsMenuButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#211E1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#765A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#29251F"/>
            <Setter Property="BorderBrush" Value="#765A32"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#BDB5AA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="14"
                CornerRadius="12"
                Background="#1D1A17"
                BorderBrush="#765A32"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="4,2,4,18">
                    <TextBlock Text="AYARLAR"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                    <TextBlock Text="Sistem yapılandırması"
                               Margin="0,4,0,0"
                               Foreground="#918A80"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="🏪  İşletme Bilgileri"
                            Tag="Business"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="🖨  Yazıcı Ayarları"
                            Tag="Printers"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="👤  Kullanıcılar"
                            Tag="Users"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="💾  Yedekleme"
                            Tag="Backup"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>

                    <Button Content="ℹ  Program Hakkında"
                            Tag="About"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="MenuButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="24"
                CornerRadius="12"
                Background="#1D1A17"
                BorderBrush="#765A32"
                BorderThickness="1">

            <Grid>
                <!-- İŞLETME -->
                <Grid x:Name="BusinessPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="İşletme Bilgileri"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Fişlerde ve program içinde kullanılacak bilgiler"
                                   Margin="0,5,0,0"
                                   Foreground="#AFA89D"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,25,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="İşletme Adı"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="BusinessNameTextBox"
                                     Style="{StaticResource FieldTextBox}"/>

                            <TextBlock Text="Telefon"
                                       Margin="0,18,0,6"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="PhoneTextBox"
                                     Style="{StaticResource FieldTextBox}"/>

                            <TextBlock Text="Vergi Dairesi"
                                       Margin="0,18,0,6"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TaxOfficeTextBox"
                                     Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Adres"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="AddressTextBox"
                                     Height="102"
                                     Padding="12,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="White"
                                     Background="#29251F"
                                     BorderBrush="#765A32"
                                     BorderThickness="1"
                                     FontSize="15"/>

                            <TextBlock Text="Vergi / T.C. Numarası"
                                       Margin="0,18,0,6"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TaxNumberTextBox"
                                     Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="2"
                            Content="Bilgileri Kaydet"
                            Width="170"
                            Height="44"
                            HorizontalAlignment="Right"
                            Click="SaveBusinessButton_Click"
                            Background="#D4A64F"
                            Foreground="#171512"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>

                <!-- YAZICILAR -->
                <Grid x:Name="PrintersPanel"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Yazıcı Ayarları"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Hazırlama fişlerinin gönderileceği yazıcıları belirleyin"
                                   Margin="0,5,0,0"
                                   Foreground="#AFA89D"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,25,0,0"
                                MaxWidth="620"
                                HorizontalAlignment="Left">

                        <TextBlock Text="Mutfak Yazıcısı"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="KitchenPrinterTextBox"
                                 Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="Bar Yazıcısı"
                                   Margin="0,18,0,6"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="BarPrinterTextBox"
                                 Style="{StaticResource FieldTextBox}"/>

                        <TextBlock Text="Kasa / Adisyon Yazıcısı"
                                   Margin="0,18,0,6"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="CashierPrinterTextBox"
                                 Style="{StaticResource FieldTextBox}"/>

                        <Border Margin="0,24,0,0"
                                Padding="14"
                                CornerRadius="8"
                                Background="#29251F"
                                BorderBrush="#554225"
                                BorderThickness="1">

                            <TextBlock Text="Yazıcı adlarını Windows → Ayarlar → Yazıcılar ekranında göründüğü şekilde yazın."
                                       TextWrapping="Wrap"
                                       Foreground="#BDB5AA"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Yazıcıları Kaydet"
                            Width="170"
                            Height="44"
                            HorizontalAlignment="Right"
                            Click="SavePrintersButton_Click"
                            Background="#D4A64F"
                            Foreground="#171512"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>

                <!-- KULLANICILAR -->
                <Grid x:Name="UsersPanel"
      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Kullanıcı ve Yetki Yönetimi"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>

                            <TextBlock Text="Personel hesaplarını, rollerini ve işlem yetkilerini yönetin"
                       Margin="0,5,0,0"
                       Foreground="#AFA89D"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                Content="+ Yeni Kullanıcı"
                Width="150"
                Height="42"
                Click="NewUserButton_Click"
                Background="#D4A64F"
                Foreground="#171512"
                BorderThickness="0"
                FontWeight="Bold"
                Cursor="Hand"/>
                    </Grid>

                    <Grid Grid.Row="1"
          Margin="0,24,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KULLANICI LİSTESİ -->
                        <Border Padding="1"
                CornerRadius="10"
                Background="#765A32">

                            <DataGrid x:Name="UsersDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionChanged="UsersDataGrid_SelectionChanged"
                      Background="#211E1A"
                      Foreground="White"
                      BorderThickness="0"
                      RowBackground="#211E1A"
                      AlternatingRowBackground="#29251F"
                      HorizontalGridLinesBrush="#3C342A"
                      VerticalGridLinesBrush="#3C342A">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Height" Value="42"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="Background" Value="#29251F"/>
                                        <Setter Property="Foreground" Value="#D4A64F"/>
                                        <Setter Property="BorderBrush" Value="#554225"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>

                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush"
                                Value="#3C342A"/>
                                        <Setter Property="Foreground"
                                Value="White"/>
                                    </Style>

                                    <Style TargetType="DataGridRow">
                                        <Setter Property="MinHeight" Value="44"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kullanıcı"
                                        Binding="{Binding FullName}"
                                        Width="*"/>

                                    <DataGridTextColumn Header="Rol"
                                        Binding="{Binding Role}"
                                        Width="95"/>

                                    <DataGridTextColumn Header="Durum"
                                        Binding="{Binding StatusText}"
                                        Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- KULLANICI FORMU -->
                        <Border Grid.Column="2"
                Padding="18"
                CornerRadius="10"
                Background="#29251F"
                BorderBrush="#765A32"
                BorderThickness="1">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="UserFormTitleText"
                               Text="Yeni Kullanıcı"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                                    <TextBlock Text="Ad Soyad"
                               Margin="0,22,0,6"
                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox x:Name="UserFullNameTextBox"
                             Style="{StaticResource TextBox.Kaldi}"
                             MaxLength="80"/>

                                    <TextBlock Text="4 Haneli PIN"
                               Margin="0,18,0,6"
                               Style="{StaticResource FieldLabel}"/>

                                    <PasswordBox x:Name="UserPinPasswordBox"
                                 Style="{StaticResource PasswordBox.Kaldi}"
                                 MaxLength="4"
                                 PreviewTextInput=
                                 "UserPinPasswordBox_PreviewTextInput"/>

                                    <TextBlock Text="Düzenlemede PIN değişmeyecekse boş bırakın."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#918A80"/>

                                    <TextBlock Text="Rol"
                               Margin="0,18,0,6"
                               Style="{StaticResource FieldLabel}"/>

                                    <ComboBox x:Name="UserRoleComboBox"
                              Style="{StaticResource ComboBox.Kaldi}"
                              SelectedIndex="2">

                                        <ComboBoxItem Content="Yönetici"/>
                                        <ComboBoxItem Content="Kasiyer"/>
                                        <ComboBoxItem Content="Garson"/>
                                    </ComboBox>

                                    <Button x:Name="SaveUserButton"
                            Content="Kullanıcıyı Kaydet"
                            Height="44"
                            Margin="0,24,0,0"
                            Click="SaveUserButton_Click"
                            Background="#D4A64F"
                            Foreground="#171512"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                                    <Button x:Name="ToggleUserStatusButton"
                            Content="Kullanıcıyı Pasifleştir"
                            Height="42"
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            Click="ToggleUserStatusButton_Click"
                            Background="#7D3C3C"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                                    <Button Content="Formu Temizle"
                            Height="40"
                            Margin="0,10,0,0"
                            Click="NewUserButton_Click"
                            Background="#3A342D"
                            Foreground="White"
                            BorderBrush="#765A32"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- YETKİLER -->
                        <Border Grid.Column="4"
                Padding="18"
                CornerRadius="10"
                Background="#29251F"
                BorderBrush="#765A32"
                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Kullanıcı Yetkileri"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#D4A64F"/>

                                    <TextBlock x:Name="PermissionInfoText"
                               Text="Yetkileri düzenlemek için listeden kullanıcı seçin."
                               Margin="0,5,0,12"
                               TextWrapping="Wrap"
                               Foreground="#AFA89D"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="Tümünü Seç"
                                Height="34"
                                Click="SelectAllPermissionsButton_Click"
                                Background="#3A342D"
                                Foreground="White"
                                BorderBrush="#765A32"
                                BorderThickness="1"
                                Cursor="Hand"/>

                                        <Button Grid.Column="2"
                                Content="Tümünü Kaldır"
                                Height="34"
                                Click="ClearAllPermissionsButton_Click"
                                Background="#3A342D"
                                Foreground="White"
                                BorderBrush="#765A32"
                                BorderThickness="1"
                                Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
                              Margin="0,14,0,14"
                              VerticalScrollBarVisibility="Auto">

                                    <StackPanel x:Name="PermissionsPanel"
                                IsEnabled="False">

                                        <TextBlock Text="SİPARİŞ İŞLEMLERİ"
                                   Margin="0,0,0,7"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                                        <CheckBox Content="Ürün ekleme"
                                  Tag="Order.AddItem"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ürün silme"
                                  Tag="Order.RemoveItem"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ürün adedini artırma"
                                  Tag="Order.IncreaseQuantity"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ürün adedini azaltma"
                                  Tag="Order.DecreaseQuantity"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Sipariş notu ekleme"
                                  Tag="Order.Note"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="İkram yapma"
                                  Tag="Order.Treat"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="İndirim uygulama"
                                  Tag="Order.Discount"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Adisyon aktarma"
                                  Tag="Order.Transfer"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <TextBlock Text="ÖDEME İŞLEMLERİ"
                                   Margin="0,18,0,7"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                                        <CheckBox Content="Nakit ödeme"
                                  Tag="Payment.Cash"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Kart ödeme"
                                  Tag="Payment.Card"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Karma ödeme"
                                  Tag="Payment.Mixed"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ödeme iadesi"
                                  Tag="Payment.Refund"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Adisyon kapatma"
                                  Tag="Payment.Close"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <TextBlock Text="MASA İŞLEMLERİ"
                                   Margin="0,18,0,7"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                                        <CheckBox Content="Masa açma"
                                  Tag="Table.Open"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Masa birleştirme"
                                  Tag="Table.Merge"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Masa ayırma"
                                  Tag="Table.Split"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <TextBlock Text="MENÜ ERİŞİMLERİ"
                                   Margin="0,18,0,7"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                                        <CheckBox Content="Ürünler menüsü"
                                  Tag="Menu.Products"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Raporlar menüsü"
                                  Tag="Menu.Reports"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Gün sonu menüsü"
                                  Tag="Menu.DayEnd"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ayarlar menüsü"
                                  Tag="Menu.Settings"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <TextBlock Text="YÖNETİM YETKİLERİ"
                                   Margin="0,18,0,7"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                                        <CheckBox Content="Kullanıcı yönetimi"
                                  Tag="Manage.Users"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Ürün yönetimi"
                                  Tag="Manage.Products"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Kategori yönetimi"
                                  Tag="Manage.Categories"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Yazıcı ayarları"
                                  Tag="Manage.Printers"
                                  Foreground="White"
                                  Margin="0,5"/>

                                        <CheckBox Content="Yedekleme"
                                  Tag="Manage.Backup"
                                  Foreground="White"
                                  Margin="0,5"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <Button x:Name="SavePermissionsButton"
                        Grid.Row="2"
                        Content="Yetkileri Kaydet"
                        Height="44"
                        IsEnabled="False"
                        Click="SavePermissionsButton_Click"
                        Background="#D4A64F"
                        Foreground="#171512"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- YEDEKLEME -->
                <Grid x:Name="BackupPanel"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Veritabanı Yedekleme"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="KaldiPOS verilerini güvenli bir konuma kopyalayın"
                                   Margin="0,5,0,0"
                                   Foreground="#AFA89D"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,35,0,0"
                                MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Padding="22"
                                CornerRadius="12"
                                Background="#29251F"
                                BorderBrush="#765A32"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="MANUEL YEDEK"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#D4A64F"/>

                                <TextBlock Text="Veritabanının tarih ve saat bilgili bir kopyası masaüstündeki KaldiPOS Yedekler klasörüne kaydedilir."
                                           Margin="0,10,0,18"
                                           TextWrapping="Wrap"
                                           Foreground="#C4BDB3"/>

                                <Button Content="Şimdi Yedekle"
                                        Width="160"
                                        Height="46"
                                        HorizontalAlignment="Left"
                                        Click="CreateBackupButton_Click"
                                        Background="#2F8F57"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LastBackupText"
                                   Margin="4,18,0,0"
                                   Foreground="#AFA89D"/>
                    </StackPanel>
                </Grid>

                <!-- HAKKINDA -->
                <Grid x:Name="AboutPanel"
                      Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="500">

                        <TextBlock Text="KALDİ POS"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#D4A64F"/>

                        <TextBlock Text="Restoran Satış ve Adisyon Sistemi"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   Foreground="White"/>

                        <Border Margin="0,28,0,0"
                                Padding="22"
                                CornerRadius="12"
                                Background="#29251F"
                                BorderBrush="#765A32"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="Sürüm: 1.0.0"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Geliştirici: Berkan Acar"
                                           Margin="0,10,0,0"
                                           Foreground="#C4BDB3"/>

                                <TextBlock Text="Yerel ve çevrimdışı çalışabilen restoran otomasyon sistemi."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#C4BDB3"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>