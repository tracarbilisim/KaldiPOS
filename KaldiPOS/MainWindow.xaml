<Window x:Class="KaldiPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KaldiPOS"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#11100E"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightPanelColumn" Width="290" />
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->
        <Border Grid.Column="0"
                Background="#181613"
                BorderBrush="#765A32"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="/Assets/kaldi-logo.png"
                           Height="95"
                           Margin="10,8,10,4"
                           Stretch="Uniform" />

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#FFFDF8">
                        <Run Text="Kaldi" />
                        <Run Text="POS"
                             Foreground="#E2BE79" />
                    </TextBlock>

                    <Border Height="1"
                            Margin="5,18,5,22"
                            Background="#765A32" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="▦   Masalar"
                            Tag="Masalar"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Primary}"
                            Margin="0,0,0,10"
                            HorizontalContentAlignment="Left" />

                    <Button Content="☕   Ürünler"
                            Tag="Ürünler"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,10"
                            HorizontalContentAlignment="Left" />

                    <Button Content="▣   Raporlar"
                            Tag="Raporlar"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,10"
                            HorizontalContentAlignment="Left" />

                    <Button Content="✓   Gün Sonu"
                            Tag="Gün Sonu"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,10"
                            HorizontalContentAlignment="Left" />

                    <Button Content="⚙   Ayarlar"
                            Tag="Ayarlar"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,10"
                            HorizontalContentAlignment="Left" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1"
                            Margin="5,0,5,16"
                            Background="#765A32" />

                    <TextBlock Text="Designed &amp; Developed by"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="#9D978D" />

                    <TextBlock Text="Berkan ACAR"
                               Margin="0,3,0,14"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#E2BE79" />

                    <Button Content="Oturumu Kapat"
                            Style="{StaticResource Button.Secondary}"
                            Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ORTA ALAN -->
        <Grid Grid.Column="1"
              Background="#11100E">

            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <!-- ÜST BAR -->
            <Border Grid.Row="0"
                    Margin="20,16,20,0"
                    Padding="22,0"
                    Background="#1A1815"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Masalar"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFDF8" />

                        <TextBlock x:Name="PageDescriptionText"
                                   Text="Salon ve masa durumlarını yönetin"
                                   Margin="0,3,0,0"
                                   FontSize="13"
                                   Foreground="#9D978D" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                        <StackPanel Margin="0,0,22,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="DateText"
                                       HorizontalAlignment="Right"
                                       FontSize="13"
                                       Foreground="#DED8CD" />

                            <TextBlock x:Name="TimeText"
                                       HorizontalAlignment="Right"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#E2BE79" />
                        </StackPanel>

                        <Border Width="1"
                                Height="38"
                                Margin="0,0,20,0"
                                Background="#765A32" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Aktif Kullanıcı"
                                       FontSize="11"
                                       Foreground="#9D978D" />

                            <TextBlock Text="Yönetici"
                                       Margin="0,3,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFDF8" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İÇERİK -->
            <Grid Grid.Row="1"
                  Margin="20">

                <Border x:Name="ContentCard"
                        Padding="24"
                        Background="#1A1815"
                        BorderBrush="#765A32"
                        BorderThickness="1"
                        CornerRadius="14">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Salonlar"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFDF8" />

                                <TextBlock Text="Bir salon seçerek masaları görüntüleyin"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Foreground="#9D978D" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Content="İç Salon"
                                        Style="{StaticResource Button.Primary}"
                                        Margin="0,0,8,0" />

                                <Button Content="Bahçe"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="0,0,8,0" />

                                <Button Content="Teras"
                                        Style="{StaticResource Button.Secondary}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1"
                                     Columns="4"
                                     Margin="0,24,0,0">

                            <Button Content="MASA 1&#x0a;Boş"
                                    Tag="Masa 1"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 2&#x0a;Boş"
                                    Tag="Masa 2"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 3&#x0a;Boş"
                                    Tag="Masa 3"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 4&#x0a;Boş"
                                    Tag="Masa 4"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 5&#x0a;Boş"
                                    Tag="Masa 5"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 6&#x0a;Boş"
                                    Tag="Masa 6"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 7&#x0a;Boş"
                                    Tag="Masa 7"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />

                            <Button Content="MASA 8&#x0a;Boş"
                                    Tag="Masa 8"
                                    Click="TableButton_Click"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="7"
                                    FontSize="17"
                                    MinHeight="115" />
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ALT DURUM -->
            <Grid Grid.Row="2"
                  Margin="22,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="9"
                             Height="9"
                             Margin="0,0,8,0"
                             Fill="#5FB67A" />

                    <TextBlock Text="Sistem hazır"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#9D978D" />
                </StackPanel>

                <TextBlock Text="KaldiPOS v1.0.0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#9D978D" />
            </Grid>
        </Grid>

        <!-- SAĞ PANEL -->
        <Border x:Name="RightStatusPanel"
                Grid.Column="2"
                Margin="0"
                Padding="18"
                Background="#181613"
                BorderBrush="#765A32"
                BorderThickness="1,0,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Anlık Durum"
                           Margin="0,6,0,18"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#FFFDF8" />

                <Border Grid.Row="1"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="#24211D"
                        BorderBrush="#765A32"
                        BorderThickness="1"
                        CornerRadius="12">

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Açık Masa"
                                       FontSize="12"
                                       Foreground="#9D978D" />

                            <TextBlock Text="0"
                                       Margin="0,5,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#E2BE79" />
                        </StackPanel>

                        <TextBlock Text="▦"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   Foreground="#765A32" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="16"
                        Background="#24211D"
                        BorderBrush="#765A32"
                        BorderThickness="1"
                        CornerRadius="12">

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Bugünkü Satış"
                                       FontSize="12"
                                       Foreground="#9D978D" />

                            <TextBlock Text="0,00 ₺"
                                       Margin="0,5,0,0"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#5FB67A" />
                        </StackPanel>

                        <TextBlock Text="₺"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="32"
                                   Foreground="#765A32" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            VerticalAlignment="Bottom">

                    <Border Padding="14"
                            Margin="0,0,0,12"
                            Background="#24211D"
                            BorderBrush="#765A32"
                            BorderThickness="1"
                            CornerRadius="12">

                        <StackPanel>
                            <TextBlock Text="Kasa Durumu"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFDF8" />

                            <TextBlock Text="Kasa açık ve işlem almaya hazır."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#9D978D" />
                        </StackPanel>
                    </Border>

                    <Button Content="Uygulamayı Kapat"
                            Style="{StaticResource Button.Danger}"
                            Click="ExitButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>