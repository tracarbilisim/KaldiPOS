<Window x:Class="KaldiPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KaldiPOS"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="768"
        Background="#11100E"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->
        <Border Grid.Column="0"
                Background="#181613"
                BorderBrush="#765A32"
                BorderThickness="0,0,1,0">

            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Button Height="46"
                            Content="☰"
                            FontSize="24"
                            Style="{StaticResource Button.Secondary}"
                            Click="ToggleMenuButton_Click" />

                    <Image x:Name="MenuLogo"
                           Source="/Assets/kaldi-logo.png"
                           Height="76"
                           Margin="6,14,6,4"
                           Stretch="Uniform"
                           Visibility="Collapsed" />

                    <TextBlock x:Name="MenuBrand"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFDF8"
                               Visibility="Collapsed">
                        <Run Text="Kaldi" />
                        <Run Text="POS" Foreground="#E2BE79" />
                    </TextBlock>

                    <Border Height="1"
                            Margin="4,14,4,14"
                            Background="#765A32" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Tag="Masalar"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Primary}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="▦" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TablesMenuText" Grid.Column="1" Text="Masalar" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button Tag="Ürünler"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="☕" FontSize="19" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ProductsMenuText" Grid.Column="1" Text="Ürünler" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button Tag="Raporlar"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="▣" FontSize="18" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ReportsMenuText" Grid.Column="1" Text="Raporlar" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button Tag="Gün Sonu"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✓" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EndOfDayMenuText" Grid.Column="1" Text="Gün Sonu" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button Tag="Ayarlar"
                            Click="MenuButton_Click"
                            Style="{StaticResource Button.Secondary}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚙" FontSize="19" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SettingsMenuText" Grid.Column="1" Text="Ayarlar" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1"
                            Margin="4,0,4,10"
                            Background="#765A32" />

                    <Button Height="44"
                            Click="LogoutButton_Click"
                            Style="{StaticResource Button.Secondary}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↪" FontSize="21" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LogoutMenuText" Grid.Column="1" Text="Oturumu Kapat" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ANA ÇALIŞMA ALANI -->
        <Grid Grid.Column="1" Background="#11100E">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ÜST BAR -->
            <Border Grid.Row="0"
                    Margin="12,10,12,0"
                    Padding="18,0"
                    Background="#1A1815"
                    BorderBrush="#765A32"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Masalar"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFDF8" />

                        <TextBlock x:Name="PageDescriptionText"
                                   Text="Salon ve masa durumlarını yönetin"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#9D978D" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DateText"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="#DED8CD" />
                            <TextBlock x:Name="TimeText"
                                       HorizontalAlignment="Right"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#E2BE79" />
                        </StackPanel>

                        <Border Width="1" Height="34" Margin="0,0,16,0" Background="#765A32" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Aktif Kullanıcı" FontSize="10" Foreground="#9D978D" />
                            <TextBlock x:Name="ActiveUserText"
                                       Text="-"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İÇERİK -->
            <Grid Grid.Row="1" Margin="12,10,12,8">
                <Border x:Name="ContentCard"
                        Padding="14"
                        Background="#1A1815"
                        BorderBrush="#765A32"
                        BorderThickness="1"
                        CornerRadius="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Salon"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFDF8" />
                                <TextBlock Text="  •  60 Masa"
                                           Margin="8,1,0,0"
                                           FontSize="12"
                                           Foreground="#9D978D" />
                            </StackPanel>

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="14,6"
                                    Background="#D2A654"
                                    CornerRadius="8">
                                <TextBlock Text="SALON"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#17130E" />
                            </Border>
                        </Grid>

                        <UniformGrid x:Name="TablesPanel"
                                     Grid.Row="1"
                                     Rows="6"
                                     Columns="10"
                                     Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ALT DURUM -->
            <Grid Grid.Row="2" Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="#5FB67A" />
                    <TextBlock Text="Sistem hazır" FontSize="11" Foreground="#9D978D" />
                </StackPanel>

                <TextBlock Text="KaldiPOS v1.0.0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#9D978D" />
            </Grid>
        </Grid>
    </Grid>
</Window>
